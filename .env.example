# Local customer-review partner demo
REVIEW_REPOSITORY=memory
IP_HASH_SECRET=development-only-change-me
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_KEY_PREFIX=qr-review
RATE_LIMIT_REQUEST_TIMEOUT_MS=1500

# Merchant dashboard / production persistence
# NODE_ENV=production
# REVIEW_REPOSITORY=postgres
# DATABASE_URL=postgresql://user:password@host:5432/qr_review
# IP_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters
# RATE_LIMIT_BACKEND=upstash
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token

# Merchant authentication
AUTH_COOKIE_NAME=qr_merchant_session
AUTH_SESSION_TTL_HOURS=168
AUTH_LOGIN_RATE_LIMIT_MAX=10

# One-time merchant admin bootstrap (used by npm run merchant:create-admin)
# MERCHANT_ADMIN_EMAIL=owner@example.com
# MERCHANT_ADMIN_PASSWORD=replace-with-a-strong-password
# MERCHANT_ADMIN_NAME=Owner Name
# MERCHANT_ORGANIZATION_NAME=Mangal Traders

REVIEW_SESSION_TTL_MINUTES=60
REVIEW_SESSION_RATE_LIMIT_MAX=30
REVIEW_GENERATE_RATE_LIMIT_MAX=12
REVIEW_EVENT_RATE_LIMIT_MAX=60
REVIEW_RATE_LIMIT_WINDOW_MS=600000
